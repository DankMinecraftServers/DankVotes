<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dankmc</groupId>
    <artifactId>dankvotes-parent</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>

    <name>DankVotes</name>
    <description>Vote rewards done right for every Minecraft server: Bukkit forks 1.7.10+ (Spigot, Paper, Purpur, Folia...), Sponge (API 8+), Velocity and BungeeCord</description>
    <url>https://dankminecraftservers.com</url>

    <!--
      DankVotes has ZERO third-party runtime dependencies. We ship our own tiny JSON
      parser instead of bundling a library. The only "dependencies" are the server APIs
      themselves (Spigot/Velocity/BungeeCord/Sponge, plus the SnakeYAML every one of them
      ships), which are <scope>provided</scope> — the server supplies them at runtime, so
      nothing extra is bundled into our jars.

      The one exception is bStats (anonymous usage metrics), which is shaded into the
      final jar and relocated to com.dankmc.dankvotes.libs.bstats so it can never clash
      with another plugin's copy.

      Modules:
        core     - platform-agnostic logic, Java 8 bytecode, no dependencies
        paper    - every Bukkit-API server: Spigot, Paper, Purpur, Folia, forks, hybrids
                   (MC 1.7.10+), Java 8
        velocity - Velocity proxy, Java 17
        bungee   - BungeeCord / Waterfall proxy, Java 8
        sponge   - Sponge API 8+ (SpongeVanilla / SpongeForge / SpongeNeo, MC 1.16.5+), Java 8
        dist     - merges them all into the single distributable jar
    -->

    <modules>
        <module>core</module>
        <module>paper</module>
        <module>velocity</module>
        <module>bungee</module>
        <module>sponge</module>
        <module>dist</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- release (not source/target) also checks the Java API, so a Java 9+ method in the
             Spigot half fails the build instead of failing on a Java 8 server. -->
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <repositories>
        <!-- SpigotMC's public group: spigot-api 1.8.8 plus the bungeecord-chat 1.8 snapshot it
             depends on (the plain snapshots repo doesn't have that one, and OSSRH is gone). -->
        <repository>
            <id>spigotmc</id>
            <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
        <!-- SpongeAPI and its libraries (per docs.spongepowered.org "Setting Up Maven"). -->
        <repository>
            <id>sponge</id>
            <url>https://repo.spongepowered.org/repository/maven-public/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
