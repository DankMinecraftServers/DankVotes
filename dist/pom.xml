<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dankmc</groupId>
        <artifactId>dankvotes-parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>dankvotes-dist</artifactId>
    <packaging>jar</packaging>

    <!--
      Distribution module. Produces the SINGLE combined jar that works on every
      supported platform.

      It merges the compiled classes of every module with each platform's descriptor.
      Each server reads only its own descriptor and loads only its own entry point:
        - Bukkit forks (Spigot, Paper, Purpur, Folia...) read plugin.yml
                                         -> DankVotesPaper    (Java 8 classes)
        - BungeeCord / Waterfall read bungee.yml (preferred over plugin.yml)
                                         -> DankVotesBungee   (Java 8 classes)
        - Velocity reads velocity-plugin.json -> DankVotesVelocity (Java 17 classes)
        - Sponge reads META-INF/sponge_plugins.json
                                         -> DankVotesSponge   (Java 8 classes)
      Code for the other platforms is simply never class-loaded.
    -->

    <dependencies>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-paper</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-velocity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-bungee</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-sponge</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>DankVotes-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.dankmc:dankvotes-core</include>
                                    <include>com.dankmc:dankvotes-paper</include>
                                    <include>com.dankmc:dankvotes-velocity</include>
                                    <include>com.dankmc:dankvotes-bungee</include>
                                    <include>com.dankmc:dankvotes-sponge</include>
                                    <include>org.bstats:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.dankmc.dankvotes.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Every descriptor must survive the merge. They live at
                                 different paths (plugin.yml, bungee.yml,
                                 velocity-plugin.json, META-INF/sponge_plugins.json), and
                                 config.yml comes only from core, so nothing collides. -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
