<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dankmc</groupId>
        <artifactId>dankvotes-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dankvotes-dist</artifactId>
    <packaging>jar</packaging>

    <!--
      Distribution module. Produces the SINGLE combined jar that works on BOTH
      Spigot/Paper/Purpur/Folia AND Velocity.

      It pulls in the compiled classes of core + paper + velocity and merges them,
      along with both descriptor files (plugin.yml from paper, velocity-plugin.json
      generated by velocity). Each platform loads only its own entry point:
        - Spigot reads plugin.yml          -> DankVotesPaper      (Java 8 classes)
        - Velocity reads velocity-plugin.json -> DankVotesVelocity (Java 17 classes)
      The unused half is simply never class-loaded on the other platform.
    -->

    <dependencies>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-core</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-paper</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.dankmc</groupId>
            <artifactId>dankvotes-velocity</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>DankVotes-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.dankmc:dankvotes-core</include>
                                    <include>com.dankmc:dankvotes-paper</include>
                                    <include>com.dankmc:dankvotes-velocity</include>
                                    <include>org.bstats:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.dankmc.dankvotes.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Both descriptors must survive the merge. They live at
                                 different paths (plugin.yml vs velocity-plugin.json) so
                                 there is no collision. -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
